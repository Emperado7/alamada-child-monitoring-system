APP_NAME="Alamada LGU Child Monitoring System"
APP_ENV=production
APP_KEY=                        # run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://YOUR-APP.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=                        # from Railway MySQL variables
DB_PORT=3306
DB_DATABASE=                    # from Railway MySQL variables
DB_USERNAME=                    # from Railway MySQL variables
DB_PASSWORD=                    # from Railway MySQL variables

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Replace with your actual Railway app domain
SANCTUM_STATEFUL_DOMAINS=YOUR-APP.up.railway.app
SESSION_DOMAIN=.railway.app
