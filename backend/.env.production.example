APP_NAME="Alamada LGU Child Monitoring System"
APP_ENV=production
APP_KEY=                        # run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://YOUR-APP.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

# Railway automatically injects DATABASE_URL when a PostgreSQL service is attached.
# Laravel reads it via the 'url' key in config/database.php, so you only need the
# individual vars below if you are NOT using the DATABASE_URL approach.
DATABASE_URL=                   # set automatically by Railway — leave blank to use individual vars

DB_CONNECTION=pgsql
DB_HOST=                        # from Railway PostgreSQL variables (PGHOST)
DB_PORT=5432                    # from Railway PostgreSQL variables (PGPORT)
DB_DATABASE=                    # from Railway PostgreSQL variables (PGDATABASE)
DB_USERNAME=                    # from Railway PostgreSQL variables (PGUSER)
DB_PASSWORD=                    # from Railway PostgreSQL variables (PGPASSWORD)
DB_SSLMODE=require              # Railway PostgreSQL requires SSL

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Replace with your actual Railway app domain
SANCTUM_STATEFUL_DOMAINS=YOUR-APP.up.railway.app
SESSION_DOMAIN=.railway.app
