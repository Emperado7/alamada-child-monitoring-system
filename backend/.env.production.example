APP_NAME="Alamada LGU Child Monitoring System"
APP_ENV=production
APP_KEY=                        # run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://YOUR-APP.onrender.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Supabase PostgreSQL connection ────────────────────────────────────────
# Get these from: Supabase dashboard → Project → Settings → Database
# Use the "Connection string" → URI tab, or fill in individually below.
#
# URI format (set as DATABASE_URL):
#   postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# Or use individual vars (recommended for Laravel):
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com   # Session pooler host
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.[YOUR-PROJECT-REF]             # e.g. postgres.abcdefghijklmnop
DB_PASSWORD=                                         # your Supabase DB password
DB_SSLMODE=require

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Replace with your actual Render app domain
APP_URL=https://YOUR-APP.onrender.com
SANCTUM_STATEFUL_DOMAINS=YOUR-APP.onrender.com
SESSION_DOMAIN=.onrender.com
