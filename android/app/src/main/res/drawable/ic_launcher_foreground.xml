<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground — uses the full Alamada logo bitmap -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="0dp"
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp">
        <bitmap
            android:src="@drawable/alamada_logo"
            android:gravity="center"
            android:tileMode="disabled"/>
    </item>
</layer-list>
