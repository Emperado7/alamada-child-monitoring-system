<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- ══ LOGO IMAGE ═════════════════════════════════════════ -->
        <ImageView
            android:layout_width="280dp"
            android:layout_height="200dp"
            android:src="@drawable/alamada_logo"
            android:scaleType="fitCenter"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="0dp"
            android:contentDescription="Alamada Learning Center Logo"/>

        <!-- ══ APP NAME ═══════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALAMADA"
            android:textColor="#1B5E20"
            android:textSize="38sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LEARNING CENTER"
            android:textColor="#2E7D32"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="4dp"/>

        <!-- Divider lines + MONITORING SYSTEM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:layout_marginBottom="24dp">
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#A5D6A7"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  MONITORING SYSTEM  "
                android:textColor="#388E3C"
                android:textSize="12sp"
                android:letterSpacing="0.1"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#A5D6A7"/>
        </LinearLayout>

        <!-- ══ WHITE LOGIN CARD ════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="0dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- Username field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_field_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="14dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        android:tint="#BDBDBD"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Username icon"/>
                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="Email Address"
                        android:textColorHint="#BDBDBD"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionNext"
                        android:background="@null"
                        android:maxLines="1"/>
                </LinearLayout>

                <!-- Password field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/input_field_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginBottom="22dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_lock_lock"
                        android:tint="#BDBDBD"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Password icon"/>
                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="Password"
                        android:textColorHint="#BDBDBD"
                        android:textColor="#212121"
                        android:textSize="15sp"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:background="@null"
                        android:maxLines="1"/>
                    <!-- Eye toggle -->
                    <TextView
                        android:id="@+id/btn_toggle_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👁"
                        android:textSize="18sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>
                </LinearLayout>

                <!-- Error message -->
                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#C62828"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp"
                    android:background="#FFEBEE"
                    android:padding="10dp"/>

                <!-- Progress bar -->
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"/>

                <!-- Log In button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Log In"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/primary"/>

                <!-- Forgotten password -->
                <TextView
                    android:id="@+id/tv_forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgotten password?"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══ GRASS / LEAVES DECORATION ══════════════════════════ -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="-2dp">

            <!-- Green wave background -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/login_grass_bg"
                android:layout_alignParentBottom="true"/>

            <!-- Left leaf cluster -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿🌿"
                android:textSize="32sp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:layout_marginStart="-4dp"
                android:layout_marginBottom="8dp"/>

            <!-- Right leaf cluster -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿🌿"
                android:textSize="32sp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="-4dp"
                android:layout_marginBottom="8dp"/>

            <!-- Flowers -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌸"
                android:textSize="22sp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="90dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌸"
                android:textSize="22sp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="90dp"
                android:layout_marginBottom="10dp"/>

        </RelativeLayout>

    </LinearLayout>
</ScrollView>
