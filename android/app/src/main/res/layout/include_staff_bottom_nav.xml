<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable 4-tab bottom navigation bar for staff screens
     Active tab is controlled per-activity by setting text color in Java. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:elevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/tab_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🏠" android:textSize="19sp" android:gravity="center"/>
            <TextView android:id="@+id/tab_home_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Home" android:textSize="10sp" android:textColor="#9E9E9E"/>
        </LinearLayout>

        <!-- Children -->
        <LinearLayout
            android:id="@+id/tab_children"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="👦" android:textSize="19sp" android:gravity="center"/>
            <TextView android:id="@+id/tab_children_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Children" android:textSize="10sp" android:textColor="#9E9E9E"/>
        </LinearLayout>

        <!-- Notifications -->
        <LinearLayout
            android:id="@+id/tab_notifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔔" android:textSize="19sp" android:gravity="center"
                    android:layout_gravity="center"/>
                <TextView
                    android:id="@+id/tv_nav_notif_badge"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/badge_red_circle"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_gravity="top|end"
                    android:visibility="gone"/>
            </FrameLayout>
            <TextView android:id="@+id/tab_notifications_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Alerts" android:textSize="10sp" android:textColor="#9E9E9E"/>
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/tab_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⚙️" android:textSize="19sp" android:gravity="center"/>
            <TextView android:id="@+id/tab_settings_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Settings" android:textSize="10sp" android:textColor="#9E9E9E"/>
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="80dp"
        android:layout_height="3dp"
        android:background="#212121"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"/>

</LinearLayout>
