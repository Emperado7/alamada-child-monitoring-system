<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/login_bg"
    android:padding="32dp">

    <!-- Alamada logo -->
    <ImageView
        android:layout_width="260dp"
        android:layout_height="180dp"
        android:src="@drawable/alamada_logo"
        android:scaleType="fitCenter"
        android:layout_marginBottom="24dp"
        android:contentDescription="Alamada Learning Center"/>

    <!-- Indeterminate progress bar — visible while server wakes up -->
    <ProgressBar
        android:id="@+id/progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="220dp"
        android:layout_height="6dp"
        android:indeterminate="true"
        android:progressTint="@color/primary"
        android:indeterminateTint="@color/primary"
        android:layout_marginBottom="16dp"/>

    <!-- Dynamic status message -->
    <TextView
        android:id="@+id/tv_splash_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connecting to server…"
        android:textColor="#2E7D32"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- Retry button — shown after 20 s if server is still loading -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⟳ Retry"
        android:textSize="13sp"
        android:visibility="gone"
        android:layout_marginBottom="10dp"
        app:cornerRadius="20dp"
        app:backgroundTint="@color/primary"/>

    <!-- Skip button — shown immediately so users are never trapped -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_skip"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Skip — Go to Login"
        android:textSize="13sp"
        android:visibility="gone"
        app:cornerRadius="20dp"
        app:strokeColor="@color/primary"
        app:strokeWidth="1.5dp"/>

</LinearLayout>
