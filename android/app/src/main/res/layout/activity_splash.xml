<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/header_green_gradient"
    android:padding="40dp">

    <!-- School logo circle -->
    <LinearLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/circle_white_bg"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:elevation="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏫"
            android:textSize="52sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alamada"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Learning Center"
        android:textColor="#E8F5E9"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Parents Mobile App"
        android:textColor="#A5D6A7"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="56dp"/>

    <!-- Spinner -->
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <!-- Dynamic status — updated while server wakes up -->
    <TextView
        android:id="@+id/tv_splash_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connecting to server…"
        android:textColor="#A5D6A7"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="4dp"/>

</LinearLayout>
